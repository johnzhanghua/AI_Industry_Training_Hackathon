# Copy to .env and fill in the values supplied with your cluster.
# Names follow Participant_Package/handout/02_execution_guide.md "Environment variables".

# LiteLLM proxy fronting both models.
LITELLM_BASE_URL="http://localhost:4000/v1"
LITELLM_KEY="sk-local-cluster"

# Model roles. Qwen plans and emits tool calls; the fine-tuned Nemotron synthesizes.
BRAIN_MODEL="agent-brain"
DOMAIN_FT_MODEL="domain-ft"

# Must be "llm" before official evaluation. "mock" bypasses the fine-tuned model
# and forfeits model-quality and architecture credit.
DOMAIN_PREDICT_MODE="llm"

# Maximum agent tool iterations.
MAX_AGENT_STEPS="5"

# Agent HTTP server bind address.
AGENT_HOST="0.0.0.0"
AGENT_PORT="5000"
